{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/MaaAssistantArknights/maa-cli/raw/v0.5.3/crates/maa-cli/schemas/cli.schema.json",
  "type": "object",
  "properties": {
    "core": {
      "type": "object",
      "properties": {
        "channel": { "$ref": "#/definitions/channel" },
        "test_time": { "type": "integer" },
        "api_url": { "type": "string", "format": "uri" },
        "components": {
          "type": "object",
          "properties": {
            "library": { "type": "boolean", "default": true },
            "resource": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "cli": {
      "type": "object",
      "properties": {
        "channel": { "$ref": "#/definitions/cli_channel" },
        "api_url": { "type": "string", "format": "uri" },
        "download_url": { "type": "string", "format": "uri" },
        "components": {
          "type": "object",
          "properties": {
            "binary": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "not": {
        "anyOf": [
          { "required": ["source", "backend"] },
          { "required": ["source", "remote"] }
        ]
      },
      "properties": {
        "auto_update": { "type": "boolean" },
        "warn_on_update_failure": { "type": "boolean" },
        "backend": { "type": "string", "enum": ["git", "libgit2"], "description": "Legacy Git implementation; cannot be combined with source" },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "const": "git" },
                "backend": { "type": "string", "enum": ["git", "libgit2"], "default": "git" },
                "branch": { "type": "string" },
                "url": { "type": "string" },
                "use_ssh_agent": { "type": "boolean" },
                "ssh_key": { "type": "string" },
                "passphrase": { "$ref": "#/definitions/passphrase" }
              }
            },
            {
              "type": "object",
              "required": ["type", "cdk"],
              "properties": {
                "type": { "const": "mirrorchyan" },
                "cdk": { "$ref": "#/definitions/passphrase" },
                "check_interval": { "type": "integer", "minimum": 0, "default": 600 }
              }
            }
          ]
        },
        "remote": {
          "type": "object",
          "properties": {
            "branch": { "type": "string", "default": "main" },
            "url": { "type": "string" },
            "use_ssh_agent": { "type": "boolean" },
            "ssh_key": { "type": "string" },
            "passphrase": { "$ref": "#/definitions/passphrase" }
          }
        }
      }
    }
  },
  "definitions": {
    "channel": {
      "type": "string",
      "enum": ["Stable", "Beta", "Alpha"]
    },
    "cli_channel": {
      "type": "string",
      "enum": ["Stable", "Beta", "Nightly"]
    },
    "passphrase": {
      "oneOf": [
        { "type": "string" },
        { "type": "boolean" },
        {
          "type": "object",
          "required": ["env"],
          "additionalProperties": false,
          "properties": {
            "env": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["cmd"],
          "additionalProperties": false,
          "properties": {
            "cmd": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    }
  }
}
